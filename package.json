{
	"devDependencies": {
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@tauri-apps/cli": "^2",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0"
	},
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"bootstrap": "pnpm install && pnpm -C prototype install",
		"tauri": "tauri"
	},
	"lint-staged": {
		"prototype/src/**/*.{ts,tsx}": [
			"pnpm -C prototype exec eslint --fix --max-warnings 10",
			"pnpm -C prototype exec prettier --write"
		],
		"prototype/src/**/*.{css,json,md}": [
			"pnpm -C prototype exec prettier --write"
		]
	}
}
