{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [{
          "type": "command",
          "command": "bash \"$HOME/.claude/hooks/session-start.sh\""
        }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{
          "type": "command",
          "command": "bash \"$HOME/.claude/hooks/post-tool-bash.sh\""
        }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{
          "type": "command",
          "command": "bash \"$HOME/.claude/hooks/enforce-worktree.sh\""
        }]
      }
    ],
    "PreCompact": [
      {
        "hooks": [{
          "type": "command",
          "command": "bash \"$HOME/.claude/hooks/pre-compact.sh\""
        }]
      }
    ],
    "Notification": [
      {
        "hooks": [{
          "type": "command",
          "command": "bash \"$HOME/.claude/hooks/notify.sh\""
        }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{
          "type": "command",
          "command": "bash \"$HOME/.claude/hooks/session-cleanup.sh\""
        }]
      }
    ]
  }
}
